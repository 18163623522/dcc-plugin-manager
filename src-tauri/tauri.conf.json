{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dcc-plugin-manager",
  "version": "0.1.0",
  "identifier": "com.pengxiwei.dcc-plugin-manager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DCC Plugin Manager",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
